# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this backend/unified applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FRONTEND_URL: The URL where the client-side SPA portal is hosted on Vercel.
FRONTEND_URL="http://localhost:3000"

# DATABASE_URL: Neon PostgreSQL connection string pointing to Neon PostgreSQL database in production
DATABASE_URL="postgresql://user:password@neon-host/ooms?sslmode=require"

# JWT_SECRET: Private encryption key used to sign and verify OOMS user session JSON Web Tokens
JWT_SECRET="EnterYourSuperSecretEnterpriseJWTKey"

# RESEND_API_KEY: Authentication token required to proxy transactional emails via the Resend platform
RESEND_API_KEY="re_123456789"

# FROM_EMAIL: Verified sender email address recognized by SMTP/Resend providers
FROM_EMAIL="OOMS Nigeria <noreply@ooms.gov.ng>"

# STORAGE_PROVIDER: Active storage driver. Supported: LOCAL_STORAGE, S3_STORAGE, GCS_STORAGE
STORAGE_PROVIDER="LOCAL_STORAGE"

# AWS_ACCESS_KEY_ID: Credentials required for Amazon web services integration (S3 Storage)
AWS_ACCESS_KEY_ID=""

# AWS_SECRET_ACCESS_KEY: Secret matching the AWS ACCESS KEY ID
AWS_SECRET_ACCESS_KEY=""

# AWS_BUCKET: Destination target bucket name inside Amazon S3 block stores
AWS_BUCKET="ooms-nigeria-storage-bucket"
